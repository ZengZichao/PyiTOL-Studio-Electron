{
  "name": "pyitol-studio",
  "version": "0.3.0",
  "description": "Desktop workbench for iTOL annotation templates — Electron edition",
  "main": "./out/main/index.cjs",
  "author": "PyiTOL Studio contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:race": "node tests/unit/sidecar-race.cjs",
    "test:e2e": "playwright test",
    "build:mac": "npm run build && electron-builder --mac --arm64",
    "package": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "i18next": "^26.7.2",
    "lucide-react": "^0.541.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.9",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
